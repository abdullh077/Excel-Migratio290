{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:pg --external:pg-native --external:drizzle-orm --external:express --external:express-session --external:connect-pg-simple --external:bcryptjs --external:pino --external:pino-http --external:zod --outfile=dist/index.mjs",
    "start": "node dist/index.mjs",
    "test": "tsx --test src/lib/clientAccounts.concurrency.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "drizzle-orm": "catalog:",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "pg": "^8.22.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "esbuild": "catalog:",
    "pino-pretty": "^13.0.0",
    "tsx": "catalog:",
    "typescript": "^5.8.3"
  }
}
